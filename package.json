{
  "name": "nexus-messenger",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && node scripts/build-demo.mjs",
    "build:mobile": "tsc -b && vite build --mode mobile",
    "cap:sync": "npm run build:mobile && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "qa:demo": "node scripts/qa-demo.mjs",
    "qa:cloud": "node scripts/qa-cloud.mjs",
    "test:db": "node scripts/check-view-once.mjs",
    "deploy:reliability": "node scripts/deploy-reliability.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "bench": "node scripts/bench-conversations.mjs",
    "test:reports": "node scripts/check-reports.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.10",
    "@sentry/react": "^11.9.0",
    "@supabase/supabase-js": "^2.57.0",
    "livekit-client": "^2.23.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@electric-sql/pglite": "^0.5.13",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.3",
    "supabase": "^2.122.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
