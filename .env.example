# Supabase Project Settings → API
# Use the Project URL and publishable key (or legacy anon key).
# Never put the service_role/secret key in a VITE_ variable.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional: local-only chats for UI work without a backend.
VITE_DEMO_MODE=false
# Optional: client error reporting, disabled when empty.
VITE_SENTRY_DSN=

# Optional: Web Push. Public VAPID key (only the public half goes to the browser).
# Generate a pair once with: npx web-push generate-vapid-keys
# The private half belongs to the Edge Function secret VAPID_PRIVATE_KEY.
VITE_VAPID_PUBLIC_KEY=
