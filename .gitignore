# Logs
# Local build scratch space (a blocked %TEMP% breaks esbuild)
.tmpbuild/

logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
node_modules
dist
dist-ssr
*.local
# Environment files
.env
.env.*
!.env.example
# Contains no secrets: only flags that build the credential-free demo bundle.
!.env.demo
# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# Supabase CLI local state
supabase/.temp/
# Capacitor native projects are generated by `npx cap add`; they hold build
# output, Gradle caches and signing files, none of which belong in review.
android/
ios/
.capacitor/
# Playwright artifacts
test-results/
playwright-report/
blob-report/
.playwright/
# Build scratch directory: the demo build points TEMP here because esbuild cannot
# delete its files from the system temp directory on some Windows machines.
.tmp/
# Ignore the preview and dev server logs.
prev.log
prev.err
# Live QA artifacts (created by scripts/qa-*.mjs, contain real sessions)
qa-accounts.json
qa-results.json
qa-step-create.png
qa-call-results.json
qa-monitoring.json
qa-out.txt
qa-acceptance.json
qa-shots/
.qa-env.json

# Временные диагностические скрипты, которые запускаются через vite-node
/*.mjs
/*.cjs
# Scratch files from one-off scripts; never meant to be committed.
/*.txt

# The raw upstream dictionary (~1 MB) is only an input to scripts/build-dictionary.mjs. What the app
# ships is the generated src/games/balda/words.data.ts, which is committed along with its checksum and
# licence notice, so the dictionary can be verified without the source. Re-download it from the URL in
# scripts/data/NOTICE.md when the word list actually needs rebuilding - it does not belong in review.
scripts/data/russian_nouns.raw.txt
